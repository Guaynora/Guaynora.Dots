# dunst — Catppuccin Mocha
[global]
    monitor = 0
    follow = mouse
    width = 340
    origin = top-right
    offset = (20, 60)
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    corner_radius = 12
    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    icon_position = left
    max_icon_size = 40
    separator_color = frame
    frame_color = "#89b4fa"
    background = "#1e1e2e"
    foreground = "#cdd6f4"

[urgency_low]
    frame_color = "#45475a"
    timeout = 4

[urgency_normal]
    timeout = 6

[urgency_critical]
    frame_color = "#f38ba8"
    timeout = 0
