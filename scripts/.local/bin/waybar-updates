#!/usr/bin/env bash
# Shows a Waybar icon only when Arch updates are available
command -v checkupdates >/dev/null || exit 0
n=$(checkupdates 2>/dev/null | wc -l)
if [ "$n" -gt 0 ]; then
  printf '{"text":"󰚰","tooltip":"%s updates available\\nClick to update","class":"available"}\n' "$n"
else
  echo '{"text":"","tooltip":"","class":"none"}'
fi
